{
  // Cloudflare settings for You Should Try.
  "name": "you-should-try",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_als"],
  // Keep variables set in the Cloudflare dashboard (like ADMIN_EMAILS) when deploying
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "you-should-try",
      // Paste the Database ID from the Cloudflare dashboard here (see README step 2).
      "database_id": "26f46a52-8c78-481e-a3d2-f82a81f38e30",
      "migrations_dir": "migrations"
    }
  ]
}
